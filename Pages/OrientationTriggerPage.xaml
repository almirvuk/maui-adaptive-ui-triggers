<?xml version="1.0" encoding="utf-8" ?>
<!-- Slide 18 · OrientationStateTrigger -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:triggers="clr-namespace:TriggersShowcase.StateTriggers"
             x:Class="TriggersShowcase.Pages.OrientationTriggerPage"
             Title="18 · Orientation"
             Shell.TabBarIsVisible="False">

    <!-- No ScrollView: the layout itself must change. No tab bar: it covers the cards in landscape. -->
    <Grid x:Name="pageRoot" Padding="32" RowSpacing="16" RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Label Style="{StaticResource HeadingLabel}" Text="OrientationStateTrigger" />
        <Label Grid.Row="1" Style="{StaticResource CaptionLabel}"
               Text="AdaptiveTrigger responds to window size; OrientationStateTrigger to device orientation." />
        <Label Grid.Row="2" Style="{StaticResource TryItLabel}"
               Text="Try it: rotate the iOS Simulator (Cmd+← / Cmd+→). On Mac it stays Landscape." />

        <Label x:Name="orientationLabel" Grid.Row="3"
               Style="{StaticResource BigValueLabel}" Text="?" />

        <StackLayout Grid.Row="4" Spacing="20">
            <!-- Custom trigger: OrientationStateTrigger stays on Portrait on iOS 27 -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Portrait">
                        <VisualState.StateTriggers>
                            <triggers:SceneOrientationStateTrigger Orientation="Portrait" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="Orientation" Value="Vertical" />
                            <Setter TargetName="orientationLabel" Property="Label.Text" Value="Portrait" />
                            <Setter TargetName="pageRoot" Property="Layout.Padding" Value="32" />
                            <Setter TargetName="pageRoot" Property="Grid.RowSpacing" Value="16" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Landscape">
                        <VisualState.StateTriggers>
                            <triggers:SceneOrientationStateTrigger Orientation="Landscape" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Property="Orientation" Value="Horizontal" />
                            <Setter TargetName="orientationLabel" Property="Label.Text" Value="Landscape" />
                            <Setter TargetName="orientationLabel" Property="Label.TextColor" Value="{StaticResource Accent}" />
                            <!-- Less spacing so the cards fit in landscape -->
                            <Setter TargetName="pageRoot" Property="Layout.Padding" Value="32,12" />
                            <Setter TargetName="pageRoot" Property="Grid.RowSpacing" Value="6" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border Style="{StaticResource Card}" WidthRequest="260"
                    HorizontalOptions="Start" VerticalOptions="Start">
                <Label Text="Card one" FontAttributes="Bold" />
            </Border>
            <Border Style="{StaticResource Card}" WidthRequest="260"
                    HorizontalOptions="Start" VerticalOptions="Start">
                <Label Text="Card two" FontAttributes="Bold" />
            </Border>
        </StackLayout>
    </Grid>
</ContentPage>
