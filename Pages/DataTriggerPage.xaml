<?xml version="1.0" encoding="utf-8" ?>
<!-- Slide 8 · Data trigger (correct vs. broken) -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TriggersShowcase.Pages.DataTriggerPage"
             Title="08 · Data trigger">

    <ScrollView>
        <VerticalStackLayout Padding="32" Spacing="20">
            <Label Style="{StaticResource HeadingLabel}" Text="Data trigger" />
            <Label Style="{StaticResource CaptionLabel}"
                   Text="Watch a binding, here another control's Text.Length." />
            <Label Style="{StaticResource TryItLabel}"
                   Text="Try it: compare the two Save buttons before typing." />

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="✓ With Text=&quot;&quot;" FontAttributes="Bold" />

                    <Entry x:Name="entry"
                           Text=""
                           Placeholder="Enter text" />
                    <Button Text="Save">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding x:DataType='Entry',
                                                           Source={x:Reference entry},
                                                           Path=Text.Length}"
                                         Value="0">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="✗ Without Text=&quot;&quot;" FontAttributes="Bold" />
                    <Label Style="{StaticResource CaptionLabel}"
                           Text="Save starts enabled even though the field is empty. Type and delete a letter and it 'fixes itself', which is why it slips through testing." />

                    <!-- Deliberately broken: no Text="", so Text is null and Text.Length never equals 0 -->
                    <Entry x:Name="brokenEntry"
                           Placeholder="Enter text" />
                    <Button Text="Save">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button"
                                         Binding="{Binding x:DataType='Entry',
                                                           Source={x:Reference brokenEntry},
                                                           Path=Text.Length}"
                                         Value="0">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
